{
  "name": "fireplus",
  "version": "0.1.0",
  "description": "A lightweight ORM library for Firebase Firestore to simplify CRUD operations.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs.js",
      "import": "./dist/index.esm.js",
      "default": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --clean",
    "test": "jest",
    "prepare": "npm run build"
  },
  "author": "anandureghu <dev.anandureghu@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/anandureghu/fireplus"
  },
  "bugs": {
    "url": "https://github.com/anandureghu/fireplus/issues"
  },
  "homepage": "https://github.com/anandureghu/fireplus#readme",
  "keywords": [
    "firebase",
    "firestore",
    "orm",
    "nodejs",
    "typescript"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@types/node": "^22.10.2",
    "firebase": "^11.3.0"
  }
}
